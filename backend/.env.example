# Free key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Or use Gemini instead (pip install langchain-google-genai)
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

MAX_RETRIES=3
ROW_LIMIT=200
QUERY_TIMEOUT_S=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
